{
  "name": "rag-writer",
  "version": "2.0.0",
  "description": "基于 RAG 的风格写作工具，模仿特定作者风格生成文章",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "ingest": "tsx src/ingest.ts",
    "ingest:force": "tsx src/ingest.ts --force"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "openai": "^4.52.0",
    "vectra": "^0.9.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
