# =========================================================================
# LLM 配置（必填）
# =========================================================================
# Moti 底层使用 OpenAI 兼容协议，可对接任何兼容该协议的大模型服务：
#   - DeepSeek        → https://api.deepseek.com              (deepseek-chat)
#   - OpenAI          → https://api.openai.com/v1             (gpt-4o-mini 等)
#   - 通义千问        → https://dashscope.aliyuncs.com/compatible-mode/v1 (qwen-plus)
#   - 智谱 GLM        → https://open.bigmodel.cn/api/paas/v4  (glm-4-flash)
#   - Moonshot        → https://api.moonshot.cn/v1            (moonshot-v1-8k)
#   - 硅基流动         → https://api.siliconflow.cn/v1
#   - 本地 vLLM / LM Studio → http://localhost:8000/v1
#
# 下方变量为系统级默认配置，后续若用户在设置页填入自己的 API Key，
# 将优先使用用户自带配置（不占用系统额度）。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your_api_key_here
LLM_MODEL=deepseek-chat

# =========================================================================
# Embedding 服务（必填）
# =========================================================================
OLLAMA_BASE_URL=http://localhost:11434

# =========================================================================
# 服务端并发保护阈值（按 2C4G 机器给出较稳的默认值）
# =========================================================================
# 文章生成并发数；超出后 `/api/authors/[id]/generate` 会直接返回 429
GENERATE_CONCURRENCY=2
# 风格分析后台消费并发数；超出的任务会进入队列等待执行
ANALYZE_CONCURRENCY=1
# 上传建索引后台消费并发数；超出的任务会进入队列等待执行
INGEST_CONCURRENCY=1

# =========================================================================
# 鉴权 & 多用户（必填）
# =========================================================================
# NextAuth 加密密钥。生成方式：`openssl rand -base64 32`
# 启动前必须配置，否则登录会话无法签名。
AUTH_SECRET=please_generate_with_openssl_rand_base64_32

# 生产部署（非 localhost 访问）必填：
# - AUTH_TRUST_HOST=true  允许 Auth.js 信任反代/自定义域名/IP 的 Host 头
# - AUTH_URL              应用对外访问的完整 URL（协议 + 域名或 IP，不带末尾斜杠）
# 本地开发（localhost:3000）可不填。
AUTH_TRUST_HOST=true
AUTH_URL=http://your-domain-or-ip

# 首次启动自动创建的 admin 账号。
# - 全新部署：用这里的邮箱和密码作为初始 admin，登录后可在设置页修改密码。
# - 从老版本升级：会自动把已有的作家 / 语料 / 生成历史全部挂到此 admin 名下。
# 已存在同名用户时不会覆盖；首次创建成功后本变量可以清空。
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change_me_after_first_login

